---
import type { Gender } from '@/types';
import { ArrowLeftIcon } from '@/assets/icons/arrow-left.tsx';
import { SparklesIcon } from '@/assets/icons/sparkles.tsx';
import GroupInfoLayout from '@/layouts/group-info.astro';

export interface Props {
  gender: Gender;
  group: string;
  teamName: string;
  showGenerateAlignment?: boolean;
  title?: string;
  backUrl?: string;
}

const {
  gender,
  group,
  teamName,
  showGenerateAlignment = false,
  title = teamName,
  backUrl = `/${gender}-${group}`,
} = Astro.props;
---

<GroupInfoLayout gender={gender} group={group}>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div class="flex flex-wrap items-center gap-3">
      <a
        href={backUrl}
        class="border-cantabria-border bg-cantabria-surface text-cantabria-text hover:border-cantabria-red hover:bg-cantabria-surface-secondary active:bg-cantabria-dark-muted/50 focus-visible:ring-cantabria-red/40 focus-visible:ring-offset-cantabria-bg inline-flex cursor-pointer items-center gap-2 rounded-lg border px-3 py-2.5 text-sm font-medium transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2"
      >
        <ArrowLeftIcon className="h-4 w-4" />
      </a>

      <h2 class="text-md text-cantabria-text font-semibold md:text-xl">
        {title}
      </h2>
    </div>
    {
      showGenerateAlignment && (
        <a
          href={`/${gender}-${group}/${teamName}/lineup`}
          class="bg-cantabria-red focus-visible:ring-cantabria-red focus-visible:ring-offset-cantabria-surface flex shrink-0 cursor-pointer items-center gap-2 rounded-lg px-5 py-2.5 text-sm font-medium text-white transition-colors duration-150 hover:bg-red-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 active:bg-red-900 sm:self-end"
        >
          <SparklesIcon className="h-4 w-4" />
          <span>Generar alineación</span>
        </a>
      )
    }
  </div>

  <slot />
</GroupInfoLayout>
